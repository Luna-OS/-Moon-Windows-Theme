{
  "modId": "windows-11-notification-center-styler",
  "modName": "Windows 11 Notification Center Styler",
  "label": "Infocenter",
  "selectedByDefault": true,
  "source": "windhawk/notification-center.yaml",
  "managedKeys": [
    "controlStyles",
    "styleConstants",
    "theme",
    "themeResourceVariables"
  ],
  "settings": {
    "theme": "",
    "styleConstants[0]": "MoonBg=<WindhawkBlur BlurAmount=\"30\" TintColor=\"#E6130F28\" FallbackColor=\"#FF130F28\"/>",
    "styleConstants[1]": "MoonFlyout=<WindhawkBlur BlurAmount=\"30\" TintColor=\"#F21A1535\" FallbackColor=\"#FF1A1535\"/>",
    "styleConstants[2]": "MoonBorder=<SolidColorBrush Color=\"#598E7CFF\"/>",
    "styleConstants[3]": "Transparent=<SolidColorBrush Color=\"Transparent\"/>",
    "styleConstants[4]": "Radius=12",
    "controlStyles[0].target": "Grid#NotificationCenterGrid",
    "controlStyles[0].styles[0]": "Background:=$MoonBg",
    "controlStyles[0].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[0].styles[2]": "BorderThickness=1",
    "controlStyles[0].styles[3]": "CornerRadius=$Radius",
    "controlStyles[1].target": "Grid#CalendarCenterGrid",
    "controlStyles[1].styles[0]": "Background:=$MoonBg",
    "controlStyles[1].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[1].styles[2]": "BorderThickness=1",
    "controlStyles[1].styles[3]": "CornerRadius=$Radius",
    "controlStyles[2].target": "ScrollViewer#CalendarControlScrollViewer",
    "controlStyles[2].styles[0]": "Background:=$Transparent",
    "controlStyles[2].styles[1]": "BorderThickness=0",
    "controlStyles[3].target": "Border#CalendarHeaderMinimizedOverlay",
    "controlStyles[3].styles[0]": "Background:=$Transparent",
    "controlStyles[3].styles[1]": "BorderThickness=0",
    "controlStyles[4].target": "ActionCenter.FocusSessionControl#FocusSessionControl > Grid#FocusGrid",
    "controlStyles[4].styles[0]": "Background:=$Transparent",
    "controlStyles[4].styles[1]": "BorderThickness=0",
    "controlStyles[5].target": "Grid#ControlCenterRegion",
    "controlStyles[5].styles[0]": "Background:=$MoonBg",
    "controlStyles[5].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[5].styles[2]": "BorderThickness=1",
    "controlStyles[5].styles[3]": "CornerRadius=$Radius",
    "controlStyles[6].target": "Grid#L1Grid > Border",
    "controlStyles[6].styles[0]": "Background:=$Transparent",
    "controlStyles[7].target": "Grid#FooterGrid",
    "controlStyles[7].styles[0]": "Background:=$Transparent",
    "controlStyles[7].styles[1]": "BorderThickness=0",
    "controlStyles[8].target": "Grid#MediaTransportControlsRegion",
    "controlStyles[8].styles[0]": "Background:=$MoonBg",
    "controlStyles[8].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[8].styles[2]": "BorderThickness=1",
    "controlStyles[8].styles[3]": "CornerRadius=$Radius",
    "controlStyles[9].target": "Grid#MediaTransportControlsRoot",
    "controlStyles[9].styles[0]": "Background:=$Transparent",
    "controlStyles[10].target": "ContentPresenter#PageContent, ContentPresenter#PageContent > Grid > Border",
    "controlStyles[10].styles[0]": "Background:=$Transparent",
    "controlStyles[11].target": "QuickActions.ControlCenter.AccessibleWindow#PageWindow > ContentPresenter > Grid#FullScreenPageRoot",
    "controlStyles[11].styles[0]": "Background:=$Transparent",
    "controlStyles[12].target": "ScrollViewer#ListContent",
    "controlStyles[12].styles[0]": "Background:=$Transparent",
    "controlStyles[13].target": "ActionCenter.FlexibleToastView#FlexibleNormalToastView",
    "controlStyles[13].styles[0]": "Background:=$Transparent",
    "controlStyles[14].target": "Border#ToastBackgroundBorder, Border#ToastBackgroundBorder2",
    "controlStyles[14].styles[0]": "Background:=$MoonBg",
    "controlStyles[14].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[14].styles[2]": "BorderThickness=1",
    "controlStyles[14].styles[3]": "CornerRadius=$Radius",
    "controlStyles[15].target": "ActionCenter.FlexibleItemView",
    "controlStyles[15].styles[0]": "CornerRadius=$Radius",
    "controlStyles[16].target": "Border#JumpListRestyledAcrylic",
    "controlStyles[16].styles[0]": "Background:=$MoonBg",
    "controlStyles[16].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[16].styles[2]": "BorderThickness=1",
    "controlStyles[16].styles[3]": "CornerRadius=$Radius",
    "controlStyles[17].target": "MenuFlyoutPresenter > Border",
    "controlStyles[17].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[17].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[17].styles[2]": "BorderThickness=1",
    "controlStyles[17].styles[3]": "CornerRadius=8",
    "themeResourceVariables[0]": "CardBackgroundFillColorDefaultBrush:=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "themeResourceVariables[1]": "CardStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#2E8E7CFF\"/>",
    "themeResourceVariables[2]": "ControlFillColorDefaultBrush:=<SolidColorBrush Color=\"#1AB8ABFF\"/>",
    "themeResourceVariables[3]": "ControlFillColorSecondaryBrush:=<SolidColorBrush Color=\"#24B8ABFF\"/>",
    "themeResourceVariables[4]": "ControlFillColorTertiaryBrush:=<SolidColorBrush Color=\"#0FB8ABFF\"/>",
    "themeResourceVariables[5]": "ControlStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#268E7CFF\"/>",
    "themeResourceVariables[6]": "SubtleFillColorSecondaryBrush:=<SolidColorBrush Color=\"#1FB8ABFF\"/>",
    "themeResourceVariables[7]": "SubtleFillColorTertiaryBrush:=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "themeResourceVariables[8]": "DividerStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#298E7CFF\"/>",
    "themeResourceVariables[9]": "TextFillColorSecondaryBrush:=<SolidColorBrush Color=\"#D0C8F5\"/>"
  }
}
