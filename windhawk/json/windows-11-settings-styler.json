{
  "modId": "windows-11-settings-styler",
  "modName": "Windows 11 Settings Styler",
  "label": "Einstellungen",
  "selectedByDefault": true,
  "source": "windhawk/settings.yaml",
  "managedKeys": [
    "controlStyles",
    "styleConstants",
    "theme",
    "themeResourceVariables"
  ],
  "settings": {
    "theme": "",
    "styleConstants[0]": "MoonStars=<ImageBrush Stretch=\"UniformToFill\" AlignmentX=\"Center\" AlignmentY=\"Center\" ImageSource=\"https://raw.githubusercontent.com/Luna-OS/Moon-Windows-Theme/main/theme/Starfield/starfield-settings.jpg\"/>",
    "styleConstants[1]": "MoonContent=<SolidColorBrush Color=\"#40130F28\"/>",
    "styleConstants[2]": "MoonCard=<SolidColorBrush Color=\"#99211A44\"/>",
    "styleConstants[3]": "MoonFlyout=<WindhawkBlur BlurAmount=\"30\" TintColor=\"#F21A1535\" FallbackColor=\"#FF1A1535\"/>",
    "styleConstants[4]": "MoonBorder=<SolidColorBrush Color=\"#598E7CFF\"/>",
    "styleConstants[5]": "MoonBorderSoft=<SolidColorBrush Color=\"#2E8E7CFF\"/>",
    "styleConstants[6]": "MoonIcon=<SolidColorBrush Color=\"{ThemeResource SystemAccentColorLight2}\"/>",
    "styleConstants[7]": "MoonTextDim=#ABA3D6",
    "styleConstants[8]": "Radius=12",
    "styleConstants[9]": "InnerRadius=8",
    "controlStyles[0].target": "SystemSettings.View.RootPage > Grid#RootPageGrid",
    "controlStyles[0].styles[0]": "Background:=$MoonStars",
    "controlStyles[1].target": "SplitView#RootSplitView > Grid > Grid#ContentRoot > Border > Grid#ContentGrid",
    "controlStyles[1].styles[0]": "Background:=$MoonContent",
    "controlStyles[1].styles[1]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[2].target": "TextBox#CommandSearchTextBox",
    "controlStyles[2].styles[0]": "CornerRadius=16",
    "controlStyles[2].styles[1]": "MinHeight=32",
    "controlStyles[2].styles[2]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[3].target": "StackPanel#SettingsCommandSearchBoxBackground",
    "controlStyles[3].styles[0]": "CornerRadius=16",
    "controlStyles[4].target": "ContentPresenter#IconContentPresenter",
    "controlStyles[4].styles[0]": "Foreground:=$MoonIcon",
    "controlStyles[5].target": "Windows.UI.Xaml.Controls.Primitives.ListViewItemPresenter > SystemSettings.View.EntityItem > Grid",
    "controlStyles[5].styles[0]": "CornerRadius=$InnerRadius",
    "controlStyles[6].target": "SystemSettings.View.SettingsListViewItem > Windows.UI.Xaml.Controls.Primitives.ListViewItemPresenter > Border",
    "controlStyles[6].styles[0]": "CornerRadius=$InnerRadius",
    "controlStyles[7].target": "SystemSettings.View.ButtonEntityItem > Button#ContainerButton > ContentPresenter#ContentPresenter",
    "controlStyles[7].styles[0]": "CornerRadius=$InnerRadius",
    "controlStyles[8].target": "SystemSettings.View.SettingsExpander > Grid > SystemSettings.View.ExpanderToggleButton#ContainerButton > ContentPresenter#ContentPresenter",
    "controlStyles[8].styles[0]": "CornerRadius=$InnerRadius",
    "controlStyles[9].target": "SystemSettings.View.SettingsExpander > Grid > ContentPresenter#RevealedContent",
    "controlStyles[9].styles[0]": "CornerRadius=0,0,$InnerRadius,$InnerRadius",
    "controlStyles[10].target": "Microsoft.ReactNative.ReactRootView > Microsoft.ReactNative.ViewPanel > Microsoft.ReactNative.ViewPanel > Microsoft.ReactNative.ViewPanel > Microsoft.ReactNative.ViewPanel > Border",
    "controlStyles[10].styles[0]": "Background:=$MoonCard",
    "controlStyles[10].styles[1]": "CornerRadius=$Radius",
    "controlStyles[11].target": "ContentPresenter#SubtitleContent > TextBlock",
    "controlStyles[11].styles[0]": "Foreground=$MoonTextDim",
    "controlStyles[12].target": "Windows.UI.Xaml.Controls.MenuFlyoutPresenter > Windows.UI.Xaml.Controls.Border",
    "controlStyles[12].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[12].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[12].styles[2]": "CornerRadius=$InnerRadius",
    "controlStyles[13].target": "Windows.UI.Xaml.Controls.FlyoutPresenter",
    "controlStyles[13].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[13].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[13].styles[2]": "CornerRadius=$InnerRadius",
    "controlStyles[14].target": "Windows.UI.Xaml.Controls.Canvas > Windows.UI.Xaml.Controls.Border#PopupBorder",
    "controlStyles[14].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[14].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[14].styles[2]": "CornerRadius=$InnerRadius",
    "controlStyles[15].target": "Windows.UI.Xaml.Controls.ToolTip > Windows.UI.Xaml.Controls.ContentPresenter#LayoutRoot",
    "controlStyles[15].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[15].styles[1]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[16].target": "Windows.UI.Xaml.Controls.Border#BackgroundElement > Windows.UI.Xaml.Controls.Grid#DialogSpace",
    "controlStyles[16].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[16].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[16].styles[2]": "CornerRadius=$Radius",
    "themeResourceVariables[0]": "CardBackgroundFillColorDefaultBrush:=<SolidColorBrush Color=\"#99211A44\"/>",
    "themeResourceVariables[1]": "CardBackgroundFillColorSecondaryBrush:=<SolidColorBrush Color=\"#80211A44\"/>",
    "themeResourceVariables[2]": "CardStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#2E8E7CFF\"/>",
    "themeResourceVariables[3]": "ControlFillColorDefaultBrush:=<SolidColorBrush Color=\"#1AB8ABFF\"/>",
    "themeResourceVariables[4]": "ControlFillColorSecondaryBrush:=<SolidColorBrush Color=\"#26B8ABFF\"/>",
    "themeResourceVariables[5]": "ControlFillColorTertiaryBrush:=<SolidColorBrush Color=\"#0FB8ABFF\"/>",
    "themeResourceVariables[6]": "ControlStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#268E7CFF\"/>",
    "themeResourceVariables[7]": "SubtleFillColorSecondaryBrush:=<SolidColorBrush Color=\"#1FB8ABFF\"/>",
    "themeResourceVariables[8]": "SubtleFillColorTertiaryBrush:=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "themeResourceVariables[9]": "DividerStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#298E7CFF\"/>",
    "themeResourceVariables[10]": "LayerFillColorDefaultBrush:=<SolidColorBrush Color=\"#40130F28\"/>",
    "themeResourceVariables[11]": "TextFillColorSecondaryBrush:=<SolidColorBrush Color=\"#D0C8F5\"/>"
  }
}
