{
  "modId": "windows-11-start-menu-styler",
  "modName": "Windows 11 Start Menu Styler",
  "label": "Startmenü",
  "selectedByDefault": true,
  "source": "windhawk/start-menu.yaml",
  "managedKeys": [
    "controlStyles",
    "styleConstants",
    "theme",
    "themeResourceVariables"
  ],
  "settings": {
    "theme": "",
    "styleConstants[0]": "MoonStars=<ImageBrush Stretch=\"UniformToFill\" AlignmentX=\"Center\" AlignmentY=\"Top\" ImageSource=\"https://raw.githubusercontent.com/Luna-OS/Moon-Windows-Theme/main/theme/Starfield/starfield-menu.jpg\"/>",
    "styleConstants[1]": "MoonBg=<WindhawkBlur BlurAmount=\"30\" TintColor=\"#E6130F28\" FallbackColor=\"#FF130F28\"/>",
    "styleConstants[2]": "MoonFlyout=<WindhawkBlur BlurAmount=\"30\" TintColor=\"#F21A1535\" FallbackColor=\"#FF1A1535\"/>",
    "styleConstants[3]": "MoonCard=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "styleConstants[4]": "MoonCardHover=<SolidColorBrush Color=\"#29B8ABFF\"/>",
    "styleConstants[5]": "MoonCardPressed=<SolidColorBrush Color=\"#1FB8ABFF\"/>",
    "styleConstants[6]": "MoonBorder=<SolidColorBrush Color=\"#598E7CFF\"/>",
    "styleConstants[7]": "MoonBorderSoft=<SolidColorBrush Color=\"#2E8E7CFF\"/>",
    "styleConstants[8]": "MoonText=#EEEAFF",
    "styleConstants[9]": "MoonTextDim=#ABA3D6",
    "styleConstants[10]": "MoonAccent=#B8ABFF",
    "styleConstants[11]": "Radius=12",
    "styleConstants[12]": "InnerRadius=8",
    "controlStyles[0].target": "Border#AcrylicBorder",
    "controlStyles[0].styles[0]": "Background:=$MoonStars",
    "controlStyles[0].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[0].styles[2]": "BorderThickness=1",
    "controlStyles[0].styles[3]": "CornerRadius=$Radius",
    "controlStyles[1].target": "Border#AcrylicOverlay",
    "controlStyles[1].styles[0]": "Opacity=0",
    "controlStyles[2].target": "StartMenu.StartBlendedFlexFrame",
    "controlStyles[2].styles[0]": "CornerRadius=$Radius",
    "controlStyles[3].target": "Border#StartDropShadow, Border#DropShadow, Border#dropshadow, Border#RightCompanionDropShadow",
    "controlStyles[3].styles[0]": "CornerRadius=$Radius",
    "controlStyles[4].target": "Border#AppBorder, Border#AccentAppBorder",
    "controlStyles[4].styles[0]": "Background:=$MoonStars",
    "controlStyles[4].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[4].styles[2]": "BorderThickness=1",
    "controlStyles[4].styles[3]": "CornerRadius=$Radius",
    "controlStyles[5].target": "Border#LayerBorder",
    "controlStyles[5].styles[0]": "Visibility=Collapsed",
    "controlStyles[6].target": "StartMenu.SearchBoxToggleButton > Grid > Border#BorderElement, StartDocked.SearchBoxToggleButton > Grid > Border#BorderElement",
    "controlStyles[6].styles[0]": "Background:=$MoonCard",
    "controlStyles[6].styles[1]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[6].styles[2]": "BorderThickness=1",
    "controlStyles[6].styles[3]": "CornerRadius=20",
    "controlStyles[7].target": "TextBlock#PlaceholderText",
    "controlStyles[7].styles[0]": "Foreground=$MoonTextDim",
    "controlStyles[8].target": "TextBlock#PinnedListHeaderText, TextBlock#AllListHeadingText, TextBlock#AllAppsHeading",
    "controlStyles[8].styles[0]": "Foreground=$MoonAccent",
    "controlStyles[9].target": "Grid#TopLevelSuggestionsListHeader > * > TextBlock",
    "controlStyles[9].styles[0]": "Foreground=$MoonAccent",
    "controlStyles[10].target": "TextBlock#AppDisplayName, TextBlock#DisplayName, TextBlock#UserTileNameText",
    "controlStyles[10].styles[0]": "Foreground=$MoonText",
    "controlStyles[11].target": "Border#ContentBorder@CommonStates > Grid#DroppedFlickerWorkaroundWrapper > Border",
    "controlStyles[11].styles[0]": "Background@PointerOver:=$MoonCardHover",
    "controlStyles[11].styles[1]": "Background@Pressed:=$MoonCardPressed",
    "controlStyles[11].styles[2]": "CornerRadius=$InnerRadius",
    "controlStyles[12].target": "ListViewItem > Grid#ContentBorder@CommonStates",
    "controlStyles[12].styles[0]": "Background@PointerOver:=$MoonCardHover",
    "controlStyles[12].styles[1]": "Background@Pressed:=$MoonCardPressed",
    "controlStyles[12].styles[2]": "CornerRadius=$InnerRadius",
    "controlStyles[13].target": "StartMenu.FolderModal > Grid > Border",
    "controlStyles[13].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[13].styles[1]": "BorderBrush:=$MoonBorder",
    "controlStyles[13].styles[2]": "BorderThickness=1",
    "controlStyles[13].styles[3]": "CornerRadius=$Radius",
    "controlStyles[14].target": "Button#ShowAllAppsButton > ContentPresenter@CommonStates",
    "controlStyles[14].styles[0]": "Background@Normal:=$MoonCard",
    "controlStyles[14].styles[1]": "Background@PointerOver:=$MoonCardHover",
    "controlStyles[14].styles[2]": "Background@Pressed:=$MoonCardPressed",
    "controlStyles[14].styles[3]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[14].styles[4]": "BorderThickness=1",
    "controlStyles[14].styles[5]": "CornerRadius=$InnerRadius",
    "controlStyles[15].target": "Microsoft.UI.Xaml.Controls.DropDownButton > Grid#RootGrid",
    "controlStyles[15].styles[0]": "Background:=$MoonCard",
    "controlStyles[15].styles[1]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[15].styles[2]": "BorderThickness=1",
    "controlStyles[15].styles[3]": "CornerRadius=$InnerRadius",
    "controlStyles[16].target": "StartDocked.NavigationPaneButton > Grid@CommonStates > Border",
    "controlStyles[16].styles[0]": "Background@PointerOver:=$MoonCardHover",
    "controlStyles[16].styles[1]": "Background@Pressed:=$MoonCardPressed",
    "controlStyles[16].styles[2]": "CornerRadius=$InnerRadius",
    "controlStyles[17].target": "MenuFlyoutPresenter > Border",
    "controlStyles[17].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[17].styles[1]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[17].styles[2]": "BorderThickness=1",
    "controlStyles[17].styles[3]": "CornerRadius=$InnerRadius",
    "controlStyles[18].target": "ToolTip",
    "controlStyles[18].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[18].styles[1]": "BorderBrush:=$MoonBorderSoft",
    "controlStyles[18].styles[2]": "CornerRadius=$InnerRadius",
    "themeResourceVariables[0]": "CardBackgroundFillColorDefaultBrush:=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "themeResourceVariables[1]": "CardBackgroundFillColorSecondaryBrush:=<SolidColorBrush Color=\"#0FB8ABFF\"/>",
    "themeResourceVariables[2]": "CardStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#2E8E7CFF\"/>",
    "themeResourceVariables[3]": "ControlFillColorDefaultBrush:=<SolidColorBrush Color=\"#1AB8ABFF\"/>",
    "themeResourceVariables[4]": "ControlFillColorSecondaryBrush:=<SolidColorBrush Color=\"#24B8ABFF\"/>",
    "themeResourceVariables[5]": "ControlFillColorTertiaryBrush:=<SolidColorBrush Color=\"#0FB8ABFF\"/>",
    "themeResourceVariables[6]": "ControlStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#268E7CFF\"/>",
    "themeResourceVariables[7]": "SubtleFillColorSecondaryBrush:=<SolidColorBrush Color=\"#1FB8ABFF\"/>",
    "themeResourceVariables[8]": "SubtleFillColorTertiaryBrush:=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "themeResourceVariables[9]": "DividerStrokeColorDefaultBrush:=<SolidColorBrush Color=\"#298E7CFF\"/>",
    "themeResourceVariables[10]": "TextFillColorSecondaryBrush:=<SolidColorBrush Color=\"#D0C8F5\"/>"
  }
}
