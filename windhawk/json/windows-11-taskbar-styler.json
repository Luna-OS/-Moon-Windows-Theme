{
  "modId": "windows-11-taskbar-styler",
  "modName": "Windows 11 Taskbar Styler",
  "label": "Taskleiste",
  "selectedByDefault": true,
  "source": "windhawk/taskbar.yaml",
  "managedKeys": [
    "controlStyles",
    "styleConstants",
    "theme",
    "themeResourceVariables"
  ],
  "settings": {
    "theme": "",
    "styleConstants[0]": "MoonBg=<WindhawkBlur BlurAmount=\"25\" TintColor=\"#D9130F28\" FallbackColor=\"#FF130F28\"/>",
    "styleConstants[1]": "MoonFlyout=<WindhawkBlur BlurAmount=\"30\" TintColor=\"#F21A1535\" FallbackColor=\"#FF1A1535\"/>",
    "styleConstants[2]": "MoonHover=<SolidColorBrush Color=\"#26B8ABFF\"/>",
    "styleConstants[3]": "MoonPressed=<SolidColorBrush Color=\"#1AB8ABFF\"/>",
    "styleConstants[4]": "MoonActive=<SolidColorBrush Color=\"#338E7CFF\"/>",
    "styleConstants[5]": "MoonActiveHover=<SolidColorBrush Color=\"#478E7CFF\"/>",
    "styleConstants[6]": "MoonBorder=#598E7CFF",
    "styleConstants[7]": "Radius=8",
    "controlStyles[0].target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundFill",
    "controlStyles[0].styles[0]": "Fill:=$MoonBg",
    "controlStyles[1].target": "Taskbar.TaskbarFrame > Grid#RootGrid > Taskbar.TaskbarBackground > Grid > Rectangle#BackgroundStroke",
    "controlStyles[1].styles[0]": "Fill=$MoonBorder",
    "controlStyles[2].target": "Taskbar.TaskbarBackground#HoverFlyoutBackgroundControl > Grid > Rectangle#BackgroundFill",
    "controlStyles[2].styles[0]": "Fill:=$MoonFlyout",
    "controlStyles[3].target": "Grid#IconPanel@CommonStates > Border#BackgroundElement, Taskbar.TaskListLabeledButtonPanel@CommonStates > Border#BackgroundElement",
    "controlStyles[3].styles[0]": "CornerRadius=$Radius",
    "controlStyles[3].styles[1]": "Background@InactiveNormal=Transparent",
    "controlStyles[3].styles[2]": "Background@InactivePointerOver:=$MoonHover",
    "controlStyles[3].styles[3]": "Background@InactivePressed:=$MoonPressed",
    "controlStyles[3].styles[4]": "Background@ActiveNormal:=$MoonActive",
    "controlStyles[3].styles[5]": "Background@ActivePointerOver:=$MoonActiveHover",
    "controlStyles[3].styles[6]": "Background@ActivePressed:=$MoonActive",
    "controlStyles[4].target": "Taskbar.ExperienceToggleButton#LaunchListButton[AutomationProperties.AutomationId=StartButton] > Taskbar.TaskListButtonPanel",
    "controlStyles[4].styles[0]": "Background:=<ImageBrush Stretch=\"Uniform\" ImageSource=\"https://raw.githubusercontent.com/Luna-OS/-Moon-Windows-Theme/main/theme/Icons/moon-start.png\"/>",
    "controlStyles[5].target": "Taskbar.ExperienceToggleButton#LaunchListButton[AutomationProperties.AutomationId=StartButton] > Taskbar.TaskListButtonPanel > Grid > Microsoft.UI.Xaml.Controls.AnimatedVisualPlayer#Icon, Taskbar.ExperienceToggleButton#LaunchListButton[AutomationProperties.AutomationId=StartButton] > Taskbar.TaskListButtonPanel > Microsoft.UI.Xaml.Controls.AnimatedVisualPlayer#Icon",
    "controlStyles[5].styles[0]": "Visibility=Collapsed",
    "controlStyles[6].target": "Taskbar.TaskListButtonPanel@CommonStates > Grid > Border#BackgroundElement, Taskbar.TaskListButtonPanel@CommonStates > Border#BackgroundElement",
    "controlStyles[6].styles[0]": "CornerRadius=$Radius",
    "controlStyles[6].styles[1]": "Background@InactiveNormal=Transparent",
    "controlStyles[6].styles[2]": "Background@InactivePointerOver:=$MoonHover",
    "controlStyles[6].styles[3]": "Background@InactivePressed:=$MoonPressed",
    "controlStyles[6].styles[4]": "Background@ActiveNormal:=$MoonActive",
    "controlStyles[6].styles[5]": "Background@ActivePointerOver:=$MoonActiveHover",
    "controlStyles[6].styles[6]": "Background@ActivePressed:=$MoonActive",
    "controlStyles[7].target": "Grid#IconPanel@RunningIndicatorStates > Rectangle#RunningIndicator, Taskbar.TaskListLabeledButtonPanel@RunningIndicatorStates > Rectangle#RunningIndicator",
    "controlStyles[7].styles[0]": "Fill=#9A90C8",
    "controlStyles[7].styles[1]": "Fill@ActiveRunningIndicator=#B8ABFF",
    "controlStyles[7].styles[2]": "Width@ActiveRunningIndicator=18",
    "controlStyles[7].styles[3]": "Fill@RequestingAttentionRunningIndicator=#FF8FB1",
    "controlStyles[8].target": "Border#OverflowFlyoutBackgroundBorder",
    "controlStyles[8].styles[0]": "Background:=$MoonFlyout",
    "controlStyles[8].styles[1]": "BorderBrush=$MoonBorder",
    "controlStyles[8].styles[2]": "CornerRadius=$Radius",
    "controlStyles[9].target": "WindowsInternal.ComposableShell.Experiences.Switcher.AltTab > Grid#ModalRootGrid > Border#BackgroundElement",
    "controlStyles[9].styles[0]": "Background=Transparent",
    "controlStyles[10].target": "WindowsInternal.ComposableShell.Experiences.Switcher.AltTab > Grid#ModalRootGrid > Border#BackgroundElement > WindowsInternal.ComposableShell.Experiences.Switcher.SwitchItemList",
    "controlStyles[10].styles[0]": "Background=#F21A1535",
    "controlStyles[11].target": "Windows.UI.Xaml.Controls.Border#BackgroundDimmingLayer",
    "controlStyles[11].styles[0]": "Background=#CC0C0A1A",
    "themeResourceVariables[0]": "ControlFillColorDefaultBrush:=<SolidColorBrush Color=\"#1AB8ABFF\"/>",
    "themeResourceVariables[1]": "ControlFillColorSecondaryBrush:=<SolidColorBrush Color=\"#24B8ABFF\"/>",
    "themeResourceVariables[2]": "SubtleFillColorSecondaryBrush:=<SolidColorBrush Color=\"#1FB8ABFF\"/>",
    "themeResourceVariables[3]": "SubtleFillColorTertiaryBrush:=<SolidColorBrush Color=\"#14B8ABFF\"/>",
    "themeResourceVariables[4]": "TextFillColorSecondaryBrush:=<SolidColorBrush Color=\"#D0C8F5\"/>"
  }
}
