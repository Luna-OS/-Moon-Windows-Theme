; Moon - Windows 11 Theme (Nachtblau + Lila)
; Wird von install.ps1 nach %LOCALAPPDATA%\Microsoft\Windows\Themes\Moon kopiert.
; Doppelklick funktioniert ebenfalls, sobald die Wallpapers dort liegen.

[Theme]
DisplayName=Moon
ThemeId={6E3C9A41-7D2B-4F5E-9C1A-4D0B8E2F6A73}

[Control Panel\Desktop]
Wallpaper=%LOCALAPPDATA%\Microsoft\Windows\Themes\Moon\Wallpapers\moon-night.jpg
TileWallpaper=0
WallpaperStyle=10
Pattern=

[VisualStyles]
Path=%SystemRoot%\resources\themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XC48E7CFF
SystemMode=Dark
AppMode=Dark
VisualStyleVersion=10

[Sounds]
SchemeName=@%SystemRoot%\System32\mmres.dll,-800

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=RJSPBS
